<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<!-- ТОВА Е КЛЮЧОВО: Сменяме x86 на x64 -->
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AogCanBridge\AogCanBridge.csproj" />
	</ItemGroup>

	<Target Name="CopyInnoMakerNativeBridge" AfterTargets="Build">
		<PropertyGroup>
			<!-- Поправяме пътя да сочи към out\build\x64-Debug или x64-Release -->
			<InnoMakerNativeBridgeSource Condition="Exists('$(MSBuildThisFileDirectory)..\InnoMakerNativeBridge\out\build\x64-Release\InnoMakerNativeBridge.dll')">$(MSBuildThisFileDirectory)..\InnoMakerNativeBridge\out\build\x64-Release\InnoMakerNativeBridge.dll</InnoMakerNativeBridgeSource>
			<InnoMakerNativeBridgeSource Condition="'$(InnoMakerNativeBridgeSource)' == '' and Exists('$(MSBuildThisFileDirectory)..\InnoMakerNativeBridge\out\build\x64-Debug\InnoMakerNativeBridge.dll')">$(MSBuildThisFileDirectory)..\InnoMakerNativeBridge\out\build\x64-Debug\InnoMakerNativeBridge.dll</InnoMakerNativeBridgeSource>
		</PropertyGroup>
		<Copy SourceFiles="$(InnoMakerNativeBridgeSource)" DestinationFolder="$(OutDir)" Condition="'$(InnoMakerNativeBridgeSource)' != ''" />
		<Warning Text="InnoMakerNativeBridge.dll was not found; native mock tests will not run." Condition="'$(InnoMakerNativeBridgeSource)' == ''" />
	</Target>
</Project>